# ============================================================
#  إعدادات Snoonu Scraper (محلياً غالباً لا تحتاج شيئاً)
# ============================================================

# كل كم دقيقة يسحب
SCRAPE_INTERVAL_MINUTES=20

# حجم الصفحة وعدد الصفحات لكل براند
PAGE_SIZE=100
MAX_PAGES=10

# ============================================================
#  للنشر على Railway
# ============================================================
# بيانات البراندات كـ JSON في سطر واحد — احصل عليه بـ: npm run brands:export
# SNOONU_BRANDS=[{"name":"BBT","email":"...","password":"..."}, ...]

# كلمة سر صفحة التحميل
# DOWNLOAD_TOKEN=

# مجلد البيانات — اربطه بـ Volume على Railway
# DATA_DIR=/app/data

# لتشغيل صفحة التحميل محلياً: ENABLE_WEB=true
